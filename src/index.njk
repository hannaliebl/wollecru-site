{#- The whole site is this one page. Content comes from src/_data/*.json,
    which editors change in Pages CMS. Markup and class names match the
    original hand-written index.html so styles.css applies unchanged. -#}
{%- macro section(id, data, headerClass, titleClass) -%}
    <header class="section-header {{ headerClass }}">
      <div class="text-container">
        <h1 id="{{ id }}" class="{{ titleClass }}">{{ data.title }}</h1>
      </div>
    </header>
    <section class="text-container">
      {%- for part in data.parts %}
      {%- if part.heading or part.text %}
      <div class="text-section">
        {%- if part.heading %}
        <h2>{{ part.heading }}</h2>
        {%- endif %}
        {{ part.text | markdown | safe }}
      </div>
      {%- endif %}
      {%- for photo in part.photos %}
      <div class="content-container-expanded{% if photo.align_left %} side-by-side-img-row{% endif %}">
        <img class="img-responsive" src="{{ photo.image }}" alt="{{ photo.alt }}" sizes="(min-width: 1226px) 1220px, (min-width: 1000px) 960px, calc(100vw - 40px)">
      </div>
      {%- endfor %}
      {%- endfor %}
    </section>
{%- endmacro -%}
<!DOCTYPE html>
<html lang='en'>

<head>
  <meta charset='utf-8'>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <link rel="canonical" href="{{ meta.url }}/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ site.title }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:url" content="{{ meta.url }}/">
  <meta property="og:image" content="{{ meta.url }}/img/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {%- set instagram = contact.instagram | replace("@", "") | trim %}
  {#- Business details for Google (https://schema.org/LocalBusiness). #}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": site.name | capitalize,
    "description": site.description,
    "url": meta.url + "/",
    "email": site.email,
    "image": meta.url + "/img/og-image.jpg",
    "logo": meta.url + site.logo,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": contact.street,
      "addressLocality": contact.city,
      "addressRegion": contact.state,
      "postalCode": contact.zip,
      "addressCountry": "US"
    },
    "sameAs": [
      ("https://instagram.com/" + instagram) if instagram,
      site.shop_url,
      contact.newsletter_embed | replace("/embed", "") if contact.newsletter_embed
    ] | select
  } | jsonLd | safe }}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=El+Messiri&family=Lato:wght@300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="container">
    <header class="page-header">
      <div class="text-container">
      <div class="logo-container">
        <img class="logo" src="{{ site.logo }}" alt="Wollecru logo" eleventy:ignore />
      </div>
      </div>

      <div class="title-text-container">
        <h1 class="page-title">{{ site.name }}</h1>
        <p class="title-subheading">{{ site.pronunciation }}</p>
        <p class="title-subheading-small">{{ site.tagline }}</p>
        <div class="logo-medium-container">
          <img class="logo-medium" src="{{ site.logo }}" alt="Wollecru logo" eleventy:ignore />
        </div>
      </div>
      <nav class="text-container"><ul>
        <li><a href="#wool">Wool</a></li>
        <li><a href="#flora">Flora</a></li>
        <li><a href="#wine">Wine</a></li>
        <li><a href="{{ site.shop_url }}">Shop</a></li>
        <li><a href="#contact">Contact and Newsletter</a></li>
      </ul></nav>
    </header>
    <section class="text-container">
      <h2>{{ intro.heading }}</h2>
      {{ intro.body | markdown | safe }}
    </section>
{{ section("wool", wool, "wool-header", "section-title") }}
{{ section("flora", flora, "flora-header", "section-title-left") }}
{{ section("wine", wine, "wine-header", "section-title-left") }}
    <header class="section-header contact-header">
      <div class="text-container">
        <h1 id="contact" class="section-title section-title-mod-contact">{{ contact.title }}</h1>
      </div>
    </header>
    <section class="text-container text-center">
      <div class="text-section">
      <p>{{ contact.names }}<br />
        {{ contact.street }}<br />
        {{ contact.city }}, {{ contact.state }} {{ contact.zip }}</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      {%- if instagram %}
      <p>Follow us on Instagram: <a href="https://instagram.com/{{ instagram }}">@{{ instagram }}</a></p>
      {%- endif %}
      <p>{{ contact.newsletter_text | markdownInline | safe }}</p>
      {%- if contact.newsletter_embed %}
      <iframe src="{{ contact.newsletter_embed }}" width="480" height="320"
        style="border:1px solid #cfc8a0; background:#cfc8a0;" frameborder="0" scrolling="no"></iframe>
      {%- endif %}
      </div>
      {%- if contact.image %}
      <img class="img-responsive img-center" src="{{ contact.image }}" alt="{{ contact.image_alt }}" sizes="(min-width: 1000px) 960px, calc(100vw - 40px)">
      {%- endif %}
      {%- if contact.credits %}
      <p>{{ contact.credits }}</p>
      {%- endif %}
    </section>
  </div>
</body>
</html>
